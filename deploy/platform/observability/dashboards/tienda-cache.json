{
  "uid": "tienda-cache",
  "title": "Tienda · Caché",
  "tags": [
    "tienda"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "% de aciertos (5 min)",
      "description": "Proporción de consultas al catálogo resueltas desde la caché en los últimos 5 minutos (todos los pods). Sin tráfico en la ventana no hay dato.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Sin tráfico",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(rate(catalog_cache_hits{job=\"tienda/tienda-api\"}[5m])) / ((sum(rate(catalog_cache_hits{job=\"tienda/tienda-api\"}[5m])) + (sum(rate(catalog_cache_misses{job=\"tienda/tienda-api\"}[5m])) or vector(0))) > 0)",
          "legendFormat": "% de aciertos (5 min)",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Aciertos en el rango seleccionado",
      "description": "Aciertos de caché acumulados en el rango de tiempo del tablero.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(increase(catalog_cache_hits{job=\"tienda/tienda-api\"}[$__range])) or vector(0)",
          "legendFormat": "Aciertos en el rango seleccionado",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fallos en el rango seleccionado",
      "description": "Fallos de caché (consultas que fueron a la base de datos) en el rango de tiempo del tablero. Vale 0 si ningún pod ha registrado fallos.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(increase(catalog_cache_misses{job=\"tienda/tienda-api\"}[$__range])) or vector(0)",
          "legendFormat": "Fallos en el rango seleccionado",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Aciertos y fallos por segundo",
      "description": "Tasa de aciertos y fallos de la caché del catálogo, sumada entre pods. Los fallos valen 0 cuando no ha habido ninguno.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "overrides": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Aciertos"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fallos"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum(rate(catalog_cache_hits{job=\"tienda/tienda-api\"}[5m]))",
          "legendFormat": "Aciertos",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "B",
          "expr": "sum(rate(catalog_cache_misses{job=\"tienda/tienda-api\"}[5m])) or vector(0)",
          "legendFormat": "Fallos",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "% de aciertos por pod",
      "description": "Proporción de aciertos de cada pod de la API. Con poco tráfico la curva es irregular porque cada fallo pesa mucho.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "refId": "A",
          "expr": "sum by (instance) (rate(catalog_cache_hits{job=\"tienda/tienda-api\"}[5m])) / ((sum by (instance) (rate(catalog_cache_hits{job=\"tienda/tienda-api\"}[5m])) + (sum by (instance) (rate(catalog_cache_misses{job=\"tienda/tienda-api\"}[5m])) or (sum by (instance) (rate(catalog_cache_hits{job=\"tienda/tienda-api\"}[5m])) * 0))) > 0)",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}