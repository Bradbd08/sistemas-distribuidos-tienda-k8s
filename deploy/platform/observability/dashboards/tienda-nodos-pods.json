{
  "uid": "tienda-nodos-pods",
  "title": "Tienda · Nodos y pods",
  "description": "Consumo de CPU, memoria y red por nodo del clúster y por pod del namespace tienda, más salud de contenedores.",
  "tags": ["tienda"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Contenedores no listos",
      "description": "Número de contenedores del clúster cuyo estado de preparación (readiness) es falso. Debe ser 0.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "count(k8s_container_ready == 0) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "No listos"
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Reinicios de contenedores en la última hora",
      "description": "Reinicios (aumento del contador k8s_container_restarts en 1 h) de los contenedores que se reiniciaron al menos una vez, ordenados de mayor a menor. Si no hay ninguno se muestra 'Sin reinicios'.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "Sin reinicios",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "sizing": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sort_desc(round(increase(k8s_container_restarts[1h]) * on (job, instance) group_left (k8s_namespace_name, k8s_pod_name, k8s_container_name) max by (job, instance, k8s_namespace_name, k8s_pod_name, k8s_container_name) (target_info)) > 0)",
          "instant": true,
          "range": false,
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}} ({{k8s_container_name}})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU por nodo",
      "description": "Uso de CPU de cada nodo del clúster, en núcleos.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "núcleos",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "k8s_node_cpu_usage * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info)",
          "legendFormat": "{{k8s_node_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memoria (working set) por nodo",
      "description": "Memoria de trabajo (working set) de cada nodo del clúster.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "k8s_node_memory_working_set * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info)",
          "legendFormat": "{{k8s_node_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Red por nodo",
      "description": "Tráfico de red de cada nodo: lo recibido se dibuja hacia arriba y lo transmitido hacia abajo (valores negativos solo por visualización).",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "transmitido (abajo) / recibido (arriba)",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "custom.transform", "value": "negative-Y" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (k8s_node_name) (rate(k8s_node_network_io{direction=\"receive\"}[$__rate_interval]) * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info))",
          "legendFormat": "{{k8s_node_name}} recibido"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (k8s_node_name) (rate(k8s_node_network_io{direction=\"transmit\"}[$__rate_interval]) * on (job, instance) group_left (k8s_node_name) max by (job, instance, k8s_node_name) (target_info))",
          "legendFormat": "{{k8s_node_name}} transmitido"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU por pod en el namespace tienda",
      "description": "Los 10 pods del namespace tienda que más CPU consumen (suma de sus contenedores), en núcleos.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "núcleos",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "topk(10, sum by (k8s_pod_name) (container_cpu_usage{job=~\"tienda/.*\"} * on (job, instance) group_left (k8s_pod_name) max by (job, instance, k8s_pod_name) (target_info)))",
          "legendFormat": "{{k8s_pod_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memoria (working set) por pod en el namespace tienda",
      "description": "Los 10 pods del namespace tienda que más memoria de trabajo usan (suma de sus contenedores).",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "topk(10, sum by (k8s_pod_name) (container_memory_working_set{job=~\"tienda/.*\"} * on (job, instance) group_left (k8s_pod_name) max by (job, instance, k8s_pod_name) (target_info)))",
          "legendFormat": "{{k8s_pod_name}}"
        }
      ]
    }
  ]
}
